{
  "name": "flappy-dash",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-observe": "~58.0.19",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "bun run web:setup && expo start --web",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "check": "bun run typecheck && bun test && bun run export:all",
    "export:web": "bun run web:setup && expo export -p web",
    "export:android": "expo export -p android --output-dir dist-android",
    "export:all": "bun run export:web && expo export -p android --output-dir dist-android",
    "assets": "bun scripts/make-assets.ts",
    "build:apk": "bunx eas-cli build -p android --profile preview",
    "build:aab": "bunx eas-cli build -p android --profile production",
    "build:ios": "bunx eas-cli build -p ios --profile production",
    "deploy:web": "bun run export:web && bunx eas-cli deploy --prod",
    "submit:android": "bunx eas-cli submit -p android --latest",
    "sounds": "bun scripts/make-sounds.ts",
    "web:setup": "setup-skia-web public",
    "lint": "expo lint",
    "postinstall": "setup-skia-web public > /dev/null"
  },
  "private": true
}
