{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flappy Dash (Tauri)",
  "version": "1.0.0",
  "identifier": "com.flappydash.tauri",
  "build": {
    "frontendDist": "www",
    "beforeBuildCommand": "cd ../../.. && bun run export:web && rm -rf ports/rust/tauri/www && cp -r dist ports/rust/tauri/www"
  },
  "app": {
    "windows": [{ "title": "Flappy Dash (Tauri)", "width": 400, "height": 820, "resizable": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"]
  }
}
